# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Receipt Storage Bucket
SUPABASE_RECEIPTS_BUCKET=household-receipts

# Default Market & Localization Settings
DEFAULT_CURRENCY_CODE=TZS
DEFAULT_CURRENCY_SYMBOL=TSh
DEFAULT_TIMEZONE=Africa/Dar_es_Salaam
DEFAULT_COUNTRY_CODE=TZ

# Firebase Cloud Messaging (Optional for Remote Push Notifications)
ENABLE_REMOTE_PUSH=false

